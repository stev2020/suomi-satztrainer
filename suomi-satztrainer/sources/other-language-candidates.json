{"data": [{"id": 7096048, "text": "Minä kaljuunnun.", "lang": "fin", "script": null, "license": "CC BY 2.0 FR", "owner": "Orava", "is_unapproved": false, "audios": [{"id": 569128, "created": "2019-02-02T02:15:31+00:00", "author": "Orava", "license": "CC BY-NC 4.0", "attribution_url": "https://tatoeba.org/user/profile/Orava", "download_url": "https://api.tatoeba.org/v1/audio/569128/file", "modified": "2019-02-02T02:15:31+00:00"}], "translations": [{"id": 3291328, "text": "Я лысею.", "lang": "rus", "script": null, "license": "CC BY 2.0 FR", "owner": "marafon", "is_unapproved": false, "is_direct": true, "audios": [{"id": 196971, "created": null, "author": "Inego", "license": "CC BY 4.0", "attribution_url": "https://tatoeba.org/user/profile/Inego", "download_url": "https://api.tatoeba.org/v1/audio/196971/file", "modified": null}]}]}, {"id": 6925654, "text": "Älä melua.", "lang": "fin", "script": null, "license": "CC BY 2.0 FR", "owner": "Orava", "is_unapproved": false, "audios": [{"id": 480462, "created": "2018-07-03T07:07:23+00:00", "author": "Orava", "license": "CC BY-NC 4.0", "attribution_url": "https://tatoeba.org/user/profile/Orava", "download_url": "https://api.tatoeba.org/v1/audio/480462/file", "modified": "2018-07-03T07:07:23+00:00"}], "translations": [{"id": 478939, "text": "Не шуми.", "lang": "rus", "script": null, "license": "CC BY 2.0 FR", "owner": "al_ex_an_der", "is_unapproved": false, "is_direct": true, "audios": []}]}, {"id": 6692464, "text": "Puhutteko ranskaa?", "lang": "fin", "script": null, "license": "CC BY 2.0 FR", "owner": "Orava", "is_unapproved": false, "audios": [{"id": 569040, "created": "2019-02-02T02:15:21+00:00", "author": "Orava", "license": "CC BY-NC 4.0", "attribution_url": "https://tatoeba.org/user/profile/Orava", "download_url": "https://api.tatoeba.org/v1/audio/569040/file", "modified": "2019-02-02T02:15:21+00:00"}], "translations": [{"id": 351645, "text": "Вы говорите по-французски?", "lang": "rus", "script": null, "license": "CC BY 2.0 FR", "owner": "Ann74", "is_unapproved": false, "is_direct": true, "audios": [{"id": 28735, "created": null, "author": "Inego", "license": "CC BY 4.0", "attribution_url": "https://tatoeba.org/user/profile/Inego", "download_url": "https://api.tatoeba.org/v1/audio/28735/file", "modified": null}]}, {"id": 2741416, "text": "Kas te räägite prantsuse keelt?", "lang": "est", "script": null, "license": "CC BY 2.0 FR", "owner": "dipdowel", "is_unapproved": false, "is_direct": true, "audios": []}]}, {"id": 6690723, "text": "Olisinpa älykäs.", "lang": "fin", "script": null, "license": "CC BY 2.0 FR", "owner": "Orava", "is_unapproved": false, "audios": [{"id": 563987, "created": "2019-01-16T10:33:39+00:00", "author": "Orava", "license": "CC BY-NC 4.0", "attribution_url": "https://tatoeba.org/user/profile/Orava", "download_url": "https://api.tatoeba.org/v1/audio/563987/file", "modified": "2019-01-16T10:33:39+00:00"}], "translations": [{"id": 445730, "text": "Ojalá fuera inteligente.", "lang": "spa", "script": null, "license": "CC BY 2.0 FR", "owner": "Shishir", "is_unapproved": false, "is_direct": true, "audios": [{"id": 34502, "created": null, "author": "marcelostockle", "license": "CC BY-NC 4.0", "attribution_url": "https://tatoeba.org/user/profile/marcelostockle", "download_url": "https://api.tatoeba.org/v1/audio/34502/file", "modified": null}]}]}, {"id": 6684532, "text": "Tehkää muistiinpanoja.", "lang": "fin", "script": null, "license": "CC BY 2.0 FR", "owner": "Orava", "is_unapproved": false, "audios": [{"id": 563982, "created": "2019-01-16T10:33:39+00:00", "author": "Orava", "license": "CC BY-NC 4.0", "attribution_url": "https://tatoeba.org/user/profile/Orava", "download_url": "https://api.tatoeba.org/v1/audio/563982/file", "modified": "2019-01-16T10:33:39+00:00"}], "translations": [{"id": 6681975, "text": "Tomad apuntes.", "lang": "spa", "script": null, "license": "CC BY 2.0 FR", "owner": "arh", "is_unapproved": false, "is_direct": true, "audios": [{"id": 422614, "created": "2018-02-11T03:19:23+00:00", "author": "arh", "license": "CC BY-NC-ND 3.0", "attribution_url": "https://tatoeba.org/user/profile/arh", "download_url": "https://api.tatoeba.org/v1/audio/422614/file", "modified": "2018-02-11T03:19:23+00:00"}]}]}, {"id": 6679347, "text": "Ilahduin kirjeestäsi.", "lang": "fin", "script": null, "license": "CC BY 2.0 FR", "owner": "Orava", "is_unapproved": false, "audios": [{"id": 563980, "created": "2019-01-16T10:33:39+00:00", "author": "Orava", "license": "CC BY-NC 4.0", "attribution_url": "https://tatoeba.org/user/profile/Orava", "download_url": "https://api.tatoeba.org/v1/audio/563980/file", "modified": "2019-01-16T10:33:39+00:00"}], "translations": [{"id": 600224, "text": "Tu carta me hizo feliz.", "lang": "spa", "script": null, "license": "CC BY 2.0 FR", "owner": "Shishir", "is_unapproved": false, "is_direct": true, "audios": [{"id": 40636, "created": null, "author": "arh", "license": "CC BY-NC-ND 3.0", "attribution_url": "https://tatoeba.org/user/profile/arh", "download_url": "https://api.tatoeba.org/v1/audio/40636/file", "modified": null}]}]}, {"id": 6677887, "text": "Olet surullinen.", "lang": "fin", "script": null, "license": "CC BY 2.0 FR", "owner": "Orava", "is_unapproved": false, "audios": [{"id": 563979, "created": "2019-01-16T10:33:39+00:00", "author": "Orava", "license": "CC BY-NC 4.0", "attribution_url": "https://tatoeba.org/user/profile/Orava", "download_url": "https://api.tatoeba.org/v1/audio/563979/file", "modified": "2019-01-16T10:33:39+00:00"}], "translations": [{"id": 4655486, "text": "Vous êtes triste.", "lang": "fra", "script": null, "license": "CC BY 2.0 FR", "owner": "sacredceltic", "is_unapproved": false, "is_direct": true, "audios": [{"id": 263775, "created": null, "author": "sacredceltic", "license": "CC BY-NC 4.0", "attribution_url": "https://tatoeba.org/user/profile/sacredceltic", "download_url": "https://api.tatoeba.org/v1/audio/263775/file", "modified": null}]}, {"id": 4807977, "text": "Estás triste.", "lang": "spa", "script": null, "license": "CC BY 2.0 FR", "owner": "Shishir", "is_unapproved": false, "is_direct": true, "audios": [{"id": 270524, "created": null, "author": "arh", "license": "CC BY-NC-ND 3.0", "attribution_url": "https://tatoeba.org/user/profile/arh", "download_url": "https://api.tatoeba.org/v1/audio/270524/file", "modified": null}]}]}, {"id": 6671920, "text": "Ei ole kylmä.", "lang": "fin", "script": null, "license": "CC BY 2.0 FR", "owner": "Orava", "is_unapproved": false, "audios": [{"id": 569324, "created": "2019-02-02T02:55:10+00:00", "author": "Orava", "license": "CC BY-NC 4.0", "attribution_url": "https://tatoeba.org/user/profile/Orava", "download_url": "https://api.tatoeba.org/v1/audio/569324/file", "modified": "2019-02-02T02:55:10+00:00"}], "translations": [{"id": 2352715, "text": "No está frío.", "lang": "spa", "script": null, "license": "CC BY 2.0 FR", "owner": "Shishir", "is_unapproved": false, "is_direct": true, "audios": [{"id": 128180, "created": null, "author": "arh", "license": "CC BY-NC-ND 3.0", "attribution_url": "https://tatoeba.org/user/profile/arh", "download_url": "https://api.tatoeba.org/v1/audio/128180/file", "modified": null}]}, {"id": 10298660, "text": "寒くないよ。", "lang": "jpn", "script": null, "license": "CC BY 2.0 FR", "owner": "small_snow", "is_unapproved": false, "is_direct": true, "audios": []}]}, {"id": 6671717, "text": "Olet outo.", "lang": "fin", "script": null, "license": "CC BY 2.0 FR", "owner": "Orava", "is_unapproved": false, "audios": [{"id": 563974, "created": "2019-01-16T10:33:39+00:00", "author": "Orava", "license": "CC BY-NC 4.0", "attribution_url": "https://tatoeba.org/user/profile/Orava", "download_url": "https://api.tatoeba.org/v1/audio/563974/file", "modified": "2019-01-16T10:33:39+00:00"}], "translations": [{"id": 4436610, "text": "Fura vagy.", "lang": "hun", "script": null, "license": "CC BY 2.0 FR", "owner": "bandeirante", "is_unapproved": false, "is_direct": true, "audios": []}, {"id": 6603036, "text": "Tú eres raro.", "lang": "spa", "script": null, "license": "CC BY 2.0 FR", "owner": "arh", "is_unapproved": false, "is_direct": true, "audios": [{"id": 412510, "created": "2018-01-14T04:02:00+00:00", "author": "arh", "license": "CC BY-NC-ND 3.0", "attribution_url": "https://tatoeba.org/user/profile/arh", "download_url": "https://api.tatoeba.org/v1/audio/412510/file", "modified": "2018-01-14T04:02:00+00:00"}]}]}, {"id": 6671707, "text": "Asun pohjoisessa.", "lang": "fin", "script": null, "license": "CC BY 2.0 FR", "owner": "Orava", "is_unapproved": false, "audios": [{"id": 563973, "created": "2019-01-16T10:33:39+00:00", "author": "Orava", "license": "CC BY-NC 4.0", "attribution_url": "https://tatoeba.org/user/profile/Orava", "download_url": "https://api.tatoeba.org/v1/audio/563973/file", "modified": "2019-01-16T10:33:39+00:00"}], "translations": [{"id": 6607890, "text": "Vivo en el norte.", "lang": "spa", "script": null, "license": "CC BY 2.0 FR", "owner": "arh", "is_unapproved": false, "is_direct": true, "audios": [{"id": 415798, "created": "2018-01-21T04:09:34+00:00", "author": "arh", "license": "CC BY-NC-ND 3.0", "attribution_url": "https://tatoeba.org/user/profile/arh", "download_url": "https://api.tatoeba.org/v1/audio/415798/file", "modified": "2018-01-21T04:09:34+00:00"}]}]}, {"id": 6607044, "text": "Kuulimme laukauksia.", "lang": "fin", "script": null, "license": "CC BY 2.0 FR", "owner": "Orava", "is_unapproved": false, "audios": [{"id": 563930, "created": "2019-01-16T10:33:37+00:00", "author": "Orava", "license": "CC BY-NC 4.0", "attribution_url": "https://tatoeba.org/user/profile/Orava", "download_url": "https://api.tatoeba.org/v1/audio/563930/file", "modified": "2019-01-16T10:33:37+00:00"}], "translations": [{"id": 6602934, "text": "Oímos tiros.", "lang": "spa", "script": null, "license": "CC BY 2.0 FR", "owner": "arh", "is_unapproved": false, "is_direct": true, "audios": [{"id": 412481, "created": "2018-01-14T04:01:58+00:00", "author": "arh", "license": "CC BY-NC-ND 3.0", "attribution_url": "https://tatoeba.org/user/profile/arh", "download_url": "https://api.tatoeba.org/v1/audio/412481/file", "modified": "2018-01-14T04:01:58+00:00"}]}, {"id": 6602936, "text": "Escuchamos disparos.", "lang": "spa", "script": null, "license": "CC BY 2.0 FR", "owner": "arh", "is_unapproved": false, "is_direct": true, "audios": [{"id": 412482, "created": "2018-01-14T04:01:58+00:00", "author": "arh", "license": "CC BY-NC-ND 3.0", "attribution_url": "https://tatoeba.org/user/profile/arh", "download_url": "https://api.tatoeba.org/v1/audio/412482/file", "modified": "2018-01-14T04:01:58+00:00"}]}, {"id": 6607042, "text": "Kuulimme aseenlaukauksia.", "lang": "fin", "script": null, "license": "CC BY 2.0 FR", "owner": "Orava", "is_unapproved": false, "is_direct": true, "audios": [{"id": 563929, "created": "2019-01-16T10:33:37+00:00", "author": "Orava", "license": "CC BY-NC 4.0", "attribution_url": "https://tatoeba.org/user/profile/Orava", "download_url": "https://api.tatoeba.org/v1/audio/563929/file", "modified": "2019-01-16T10:33:37+00:00"}]}]}, {"id": 6585898, "text": "Vihaan maanantaita.", "lang": "fin", "script": null, "license": "CC BY 2.0 FR", "owner": "Orava", "is_unapproved": false, "audios": [{"id": 563918, "created": "2019-01-16T10:33:36+00:00", "author": "Orava", "license": "CC BY-NC 4.0", "attribution_url": "https://tatoeba.org/user/profile/Orava", "download_url": "https://api.tatoeba.org/v1/audio/563918/file", "modified": "2019-01-16T10:33:36+00:00"}], "translations": [{"id": 576089, "text": "Odio los lunes.", "lang": "spa", "script": null, "license": "CC BY 2.0 FR", "owner": "Shishir", "is_unapproved": false, "is_direct": true, "audios": [{"id": 40007, "created": null, "author": "arh", "license": "CC BY-NC-ND 3.0", "attribution_url": "https://tatoeba.org/user/profile/arh", "download_url": "https://api.tatoeba.org/v1/audio/40007/file", "modified": null}]}]}, {"id": 6577834, "text": "Riisuin kenkäni.", "lang": "fin", "script": null, "license": "CC BY 2.0 FR", "owner": "Orava", "is_unapproved": false, "audios": [{"id": 563912, "created": "2019-01-16T10:33:36+00:00", "author": "Orava", "license": "CC BY-NC 4.0", "attribution_url": "https://tatoeba.org/user/profile/Orava", "download_url": "https://api.tatoeba.org/v1/audio/563912/file", "modified": "2019-01-16T10:33:36+00:00"}], "translations": [{"id": 1595395, "text": "Me quité los zapatos.", "lang": "spa", "script": null, "license": "CC BY 2.0 FR", "owner": "Shishir", "is_unapproved": false, "is_direct": true, "audios": [{"id": 75570, "created": null, "author": "arh", "license": "CC BY-NC-ND 3.0", "attribution_url": "https://tatoeba.org/user/profile/arh", "download_url": "https://api.tatoeba.org/v1/audio/75570/file", "modified": null}]}]}, {"id": 6565159, "text": "Vuokrasimme kanootin.", "lang": "fin", "script": null, "license": "CC BY 2.0 FR", "owner": "Orava", "is_unapproved": false, "audios": [{"id": 563906, "created": "2019-01-16T10:33:36+00:00", "author": "Orava", "license": "CC BY-NC 4.0", "attribution_url": "https://tatoeba.org/user/profile/Orava", "download_url": "https://api.tatoeba.org/v1/audio/563906/file", "modified": "2019-01-16T10:33:36+00:00"}], "translations": [{"id": 619599, "text": "Alquilamos una canoa.", "lang": "spa", "script": null, "license": "CC BY 2.0 FR", "owner": "Shishir", "is_unapproved": false, "is_direct": true, "audios": [{"id": 41226, "created": null, "author": "arh", "license": "CC BY-NC-ND 3.0", "attribution_url": "https://tatoeba.org/user/profile/arh", "download_url": "https://api.tatoeba.org/v1/audio/41226/file", "modified": null}]}]}, {"id": 6564219, "text": "Varoitin Tomia.", "lang": "fin", "script": null, "license": "CC BY 2.0 FR", "owner": "Orava", "is_unapproved": false, "audios": [{"id": 563905, "created": "2019-01-16T10:33:36+00:00", "author": "Orava", "license": "CC BY-NC 4.0", "attribution_url": "https://tatoeba.org/user/profile/Orava", "download_url": "https://api.tatoeba.org/v1/audio/563905/file", "modified": "2019-01-16T10:33:36+00:00"}], "translations": [{"id": 2624530, "text": "He avisado a Tom.", "lang": "spa", "script": null, "license": "CC BY 2.0 FR", "owner": "Shishir", "is_unapproved": false, "is_direct": true, "audios": [{"id": 152841, "created": null, "author": "arh", "license": "CC BY-NC-ND 3.0", "attribution_url": "https://tatoeba.org/user/profile/arh", "download_url": "https://api.tatoeba.org/v1/audio/152841/file", "modified": null}]}]}, {"id": 5011452, "text": "En pelkää ikääntymistä.", "lang": "fin", "script": null, "license": "CC BY 2.0 FR", "owner": "Orava", "is_unapproved": false, "audios": [{"id": 568798, "created": "2019-02-02T02:04:58+00:00", "author": "Orava", "license": "CC BY-NC 4.0", "attribution_url": "https://tatoeba.org/user/profile/Orava", "download_url": "https://api.tatoeba.org/v1/audio/568798/file", "modified": "2019-02-02T02:04:58+00:00"}], "translations": [{"id": 4143886, "text": "Я не боюсь стареть.", "lang": "rus", "script": null, "license": "CC BY 2.0 FR", "owner": "odexed", "is_unapproved": false, "is_direct": true, "audios": []}]}, {"id": 4922863, "text": "Tomilla on kaksoiskansalaisuus.", "lang": "fin", "script": null, "license": "CC BY 2.0 FR", "owner": "Orava", "is_unapproved": false, "audios": [{"id": 568676, "created": "2019-02-02T02:04:44+00:00", "author": "Orava", "license": "CC BY-NC 4.0", "attribution_url": "https://tatoeba.org/user/profile/Orava", "download_url": "https://api.tatoeba.org/v1/audio/568676/file", "modified": "2019-02-02T02:04:44+00:00"}], "translations": [{"id": 4445468, "text": "У Тома двойное гражданство.", "lang": "rus", "script": null, "license": "CC BY 2.0 FR", "owner": "odexed", "is_unapproved": false, "is_direct": true, "audios": []}]}, {"id": 4842069, "text": "Hän lähti yrityksestä.", "lang": "fin", "script": null, "license": "CC BY 2.0 FR", "owner": "Orava", "is_unapproved": false, "audios": [{"id": 568654, "created": "2019-02-02T02:04:41+00:00", "author": "Orava", "license": "CC BY-NC 4.0", "attribution_url": "https://tatoeba.org/user/profile/Orava", "download_url": "https://api.tatoeba.org/v1/audio/568654/file", "modified": "2019-02-02T02:04:41+00:00"}], "translations": [{"id": 1280546, "text": "Ha lasciato l'impresa.", "lang": "ita", "script": null, "license": "CC BY 2.0 FR", "owner": "Guybrush88", "is_unapproved": false, "is_direct": true, "audios": []}]}, {"id": 4584128, "text": "Oletteko pesseet hampaanne?", "lang": "fin", "script": null, "license": "CC BY 2.0 FR", "owner": "Orava", "is_unapproved": false, "audios": [{"id": 568641, "created": "2019-02-02T02:04:39+00:00", "author": "Orava", "license": "CC BY-NC 4.0", "attribution_url": "https://tatoeba.org/user/profile/Orava", "download_url": "https://api.tatoeba.org/v1/audio/568641/file", "modified": "2019-02-02T02:04:39+00:00"}], "translations": [{"id": 3663225, "text": "Vi siete lavate i denti?", "lang": "ita", "script": null, "license": "CC BY 2.0 FR", "owner": "Guybrush88", "is_unapproved": false, "is_direct": true, "audios": []}]}, {"id": 4562296, "text": "Vaimoni laittaa ruokaa.", "lang": "fin", "script": null, "license": "CC BY 2.0 FR", "owner": "Orava", "is_unapproved": false, "audios": [{"id": 568639, "created": "2019-02-02T02:04:38+00:00", "author": "Orava", "license": "CC BY-NC 4.0", "attribution_url": "https://tatoeba.org/user/profile/Orava", "download_url": "https://api.tatoeba.org/v1/audio/568639/file", "modified": "2019-02-02T02:04:38+00:00"}], "translations": [{"id": 459248, "text": "Mi mujer está cocinando.", "lang": "spa", "script": null, "license": "CC BY 2.0 FR", "owner": "Shishir", "is_unapproved": false, "is_direct": true, "audios": [{"id": 35319, "created": null, "author": "marcelostockle", "license": "CC BY-NC 4.0", "attribution_url": "https://tatoeba.org/user/profile/marcelostockle", "download_url": "https://api.tatoeba.org/v1/audio/35319/file", "modified": null}]}]}, {"id": 4537759, "text": "Tomi voiteli leipäviipaleen.", "lang": "fin", "script": null, "license": "CC BY 2.0 FR", "owner": "Orava", "is_unapproved": false, "audios": [{"id": 568638, "created": "2019-02-02T02:04:38+00:00", "author": "Orava", "license": "CC BY-NC 4.0", "attribution_url": "https://tatoeba.org/user/profile/Orava", "download_url": "https://api.tatoeba.org/v1/audio/568638/file", "modified": "2019-02-02T02:04:38+00:00"}], "translations": [{"id": 3382491, "text": "Tom ha imburrato una fetta di pane.", "lang": "ita", "script": null, "license": "CC BY 2.0 FR", "owner": "Guybrush88", "is_unapproved": false, "is_direct": true, "audios": []}]}, {"id": 4534552, "text": "Passini on varastettu.", "lang": "fin", "script": null, "license": "CC BY 2.0 FR", "owner": "Orava", "is_unapproved": false, "audios": [{"id": 568636, "created": "2019-02-02T02:04:38+00:00", "author": "Orava", "license": "CC BY-NC 4.0", "attribution_url": "https://tatoeba.org/user/profile/Orava", "download_url": "https://api.tatoeba.org/v1/audio/568636/file", "modified": "2019-02-02T02:04:38+00:00"}], "translations": [{"id": 534046, "text": "Me han robado el pasaporte.", "lang": "spa", "script": null, "license": "CC BY 2.0 FR", "owner": "Shishir", "is_unapproved": false, "is_direct": true, "audios": [{"id": 39098, "created": null, "author": "marcelostockle", "license": "CC BY-NC 4.0", "attribution_url": "https://tatoeba.org/user/profile/marcelostockle", "download_url": "https://api.tatoeba.org/v1/audio/39098/file", "modified": null}]}]}, {"id": 4534536, "text": "Sytytä valot, kiitos.", "lang": "fin", "script": null, "license": "CC BY 2.0 FR", "owner": "Orava", "is_unapproved": false, "audios": [{"id": 568634, "created": "2019-02-02T02:04:37+00:00", "author": "Orava", "license": "CC BY-NC 4.0", "attribution_url": "https://tatoeba.org/user/profile/Orava", "download_url": "https://api.tatoeba.org/v1/audio/568634/file", "modified": "2019-02-02T02:04:37+00:00"}], "translations": [{"id": 503616, "text": "Enciende la luz, por favor.", "lang": "spa", "script": null, "license": "CC BY 2.0 FR", "owner": "Shishir", "is_unapproved": false, "is_direct": true, "audios": [{"id": 38244, "created": null, "author": "marcelostockle", "license": "CC BY-NC 4.0", "attribution_url": "https://tatoeba.org/user/profile/marcelostockle", "download_url": "https://api.tatoeba.org/v1/audio/38244/file", "modified": null}]}]}, {"id": 4534508, "text": "Tomi menetti työnsä.", "lang": "fin", "script": null, "license": "CC BY 2.0 FR", "owner": "Orava", "is_unapproved": false, "audios": [{"id": 568633, "created": "2019-02-02T02:04:37+00:00", "author": "Orava", "license": "CC BY-NC 4.0", "attribution_url": "https://tatoeba.org/user/profile/Orava", "download_url": "https://api.tatoeba.org/v1/audio/568633/file", "modified": "2019-02-02T02:04:37+00:00"}], "translations": [{"id": 500116, "text": "Tom perdió su trabajo.", "lang": "spa", "script": null, "license": "CC BY 2.0 FR", "owner": "Shishir", "is_unapproved": false, "is_direct": true, "audios": [{"id": 38097, "created": null, "author": "marcelostockle", "license": "CC BY-NC 4.0", "attribution_url": "https://tatoeba.org/user/profile/marcelostockle", "download_url": "https://api.tatoeba.org/v1/audio/38097/file", "modified": null}]}]}, {"id": 4534480, "text": "En pidä kesästä.", "lang": "fin", "script": null, "license": "CC BY 2.0 FR", "owner": "Orava", "is_unapproved": false, "audios": [{"id": 568632, "created": "2019-02-02T02:04:37+00:00", "author": "Orava", "license": "CC BY-NC 4.0", "attribution_url": "https://tatoeba.org/user/profile/Orava", "download_url": "https://api.tatoeba.org/v1/audio/568632/file", "modified": "2019-02-02T02:04:37+00:00"}], "translations": [{"id": 501964, "text": "No me gusta el verano.", "lang": "spa", "script": null, "license": "CC BY 2.0 FR", "owner": "Shishir", "is_unapproved": false, "is_direct": true, "audios": [{"id": 38155, "created": null, "author": "marcelostockle", "license": "CC BY-NC 4.0", "attribution_url": "https://tatoeba.org/user/profile/marcelostockle", "download_url": "https://api.tatoeba.org/v1/audio/38155/file", "modified": null}]}]}, {"id": 4532943, "text": "Bussi lähti juuri.", "lang": "fin", "script": null, "license": "CC BY 2.0 FR", "owner": "Orava", "is_unapproved": false, "audios": [{"id": 568630, "created": "2019-02-02T02:04:36+00:00", "author": "Orava", "license": "CC BY-NC 4.0", "attribution_url": "https://tatoeba.org/user/profile/Orava", "download_url": "https://api.tatoeba.org/v1/audio/568630/file", "modified": "2019-02-02T02:04:36+00:00"}], "translations": [{"id": 1127433, "text": "El bus acaba de partir.", "lang": "spa", "script": null, "license": "CC BY 2.0 FR", "owner": "marcelostockle", "is_unapproved": false, "is_direct": true, "audios": [{"id": 64780, "created": null, "author": "marcelostockle", "license": "CC BY-NC 4.0", "attribution_url": "https://tatoeba.org/user/profile/marcelostockle", "download_url": "https://api.tatoeba.org/v1/audio/64780/file", "modified": null}]}]}, {"id": 4477115, "text": "Kuka te olette?", "lang": "fin", "script": null, "license": "CC BY 2.0 FR", "owner": "Orava", "is_unapproved": false, "audios": [{"id": 568627, "created": "2019-02-02T02:04:36+00:00", "author": "Orava", "license": "CC BY-NC 4.0", "attribution_url": "https://tatoeba.org/user/profile/Orava", "download_url": "https://api.tatoeba.org/v1/audio/568627/file", "modified": "2019-02-02T02:04:36+00:00"}], "translations": [{"id": 826786, "text": "Кто вы?", "lang": "rus", "script": null, "license": "CC BY 2.0 FR", "owner": "Patissier", "is_unapproved": false, "is_direct": true, "audios": [{"id": 1267560, "created": "2025-06-11T06:19:36+00:00", "author": "EugeneGS", "license": "CC BY-NC 4.0", "attribution_url": "https://tatoeba.org/user/profile/EugeneGS", "download_url": "https://api.tatoeba.org/v1/audio/1267560/file", "modified": "2025-06-11T06:19:36+00:00"}]}, {"id": 1979477, "text": "Hvem er De?", "lang": "dan", "script": null, "license": "CC BY 2.0 FR", "owner": "volhardt", "is_unapproved": false, "is_direct": true, "audios": []}, {"id": 2134537, "text": "Вы кто?", "lang": "rus", "script": null, "license": "CC BY 2.0 FR", "owner": "marafon", "is_unapproved": false, "is_direct": true, "audios": [{"id": 103675, "created": null, "author": "Inego", "license": "CC BY 4.0", "attribution_url": "https://tatoeba.org/user/profile/Inego", "download_url": "https://api.tatoeba.org/v1/audio/103675/file", "modified": null}, {"id": 1267458, "created": "2025-06-11T06:19:29+00:00", "author": "EugeneGS", "license": "CC BY-NC 4.0", "attribution_url": "https://tatoeba.org/user/profile/EugeneGS", "download_url": "https://api.tatoeba.org/v1/audio/1267458/file", "modified": "2025-06-11T06:19:29+00:00"}]}, {"id": 3200316, "text": "Kik vagytok?", "lang": "hun", "script": null, "license": "CC BY 2.0 FR", "owner": "Aleksandro40", "is_unapproved": false, "is_direct": true, "audios": []}, {"id": 3666894, "text": "¿Quién es usted?", "lang": "spa", "script": null, "license": "CC BY 2.0 FR", "owner": "Seael", "is_unapproved": false, "is_direct": true, "audios": [{"id": 221592, "created": null, "author": "Seael", "license": "", "attribution_url": "https://tatoeba.org/user/profile/Seael", "download_url": "https://api.tatoeba.org/v1/audio/221592/file", "modified": null}]}, {"id": 5000614, "text": "Те кӧ улыда?", "lang": "mhr", "script": null, "license": "CC BY 2.0 FR", "owner": "Erviy", "is_unapproved": false, "is_direct": true, "audios": []}, {"id": 13911636, "text": "Kes te olete?", "lang": "est", "script": null, "license": "CC BY 2.0 FR", "owner": null, "is_unapproved": false, "is_direct": true, "audios": []}]}, {"id": 4036299, "text": "Linnut rakentavat pesiä.", "lang": "fin", "script": null, "license": "CC BY 2.0 FR", "owner": "Orava", "is_unapproved": false, "audios": [{"id": 568975, "created": "2019-02-02T02:14:39+00:00", "author": "Orava", "license": "CC BY-NC 4.0", "attribution_url": "https://tatoeba.org/user/profile/Orava", "download_url": "https://api.tatoeba.org/v1/audio/568975/file", "modified": "2019-02-02T02:14:39+00:00"}], "translations": [{"id": 1245294, "text": "Los pájaros construyen nidos.", "lang": "spa", "script": null, "license": "CC BY 2.0 FR", "owner": "hayastan", "is_unapproved": false, "is_direct": true, "audios": [{"id": 444297, "created": "2018-03-31T07:30:30+00:00", "author": "arh", "license": "CC BY-NC-ND 3.0", "attribution_url": "https://tatoeba.org/user/profile/arh", "download_url": "https://api.tatoeba.org/v1/audio/444297/file", "modified": "2018-03-31T07:30:30+00:00"}]}]}, {"id": 2135533, "text": "Hän löysi pyöräni.", "lang": "fin", "script": null, "license": "CC BY 2.0 FR", "owner": "Orava", "is_unapproved": false, "audios": [{"id": 568972, "created": "2019-02-02T02:14:38+00:00", "author": "Orava", "license": "CC BY-NC 4.0", "attribution_url": "https://tatoeba.org/user/profile/Orava", "download_url": "https://api.tatoeba.org/v1/audio/568972/file", "modified": "2019-02-02T02:14:38+00:00"}], "translations": [{"id": 2135530, "text": "Han hittade min cykel.", "lang": "swe", "script": null, "license": "CC BY 2.0 FR", "owner": "herrsilen", "is_unapproved": false, "is_direct": true, "audios": []}]}], "paging": {"total": 29, "has_next": false}}